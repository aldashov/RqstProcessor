# Шаблон конфигурации окружения приложения
# Скопируйте этот файл, переименуйте в .env и укажите ваши локальные данные

# Порт, на котором будет запускаться веб-сервер приложения
APP_PORT=8081

# Строка подключения к PostgreSQL (Параметры: user, password, host, port, dbname)
# Пример для локального запуска: postgres://username:password@localhost:5432/dbname?sslmode=disable
DATABASE_URL=postgres://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=disable