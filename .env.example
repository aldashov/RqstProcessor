# Шаблон конфигурации окружения приложения
# Скопируйте этот файл, переименуйте в .env и укажите ваши локальные данные

# Порт публикации веб-сервера приложения
APP_PORT=8081

# Конфигурация учётных записей PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=укажите_ваш_секретный_пароль
POSTGRES_DB=postgres

# Полная строка подключения для Go-приложения внутри Docker-сети
DATABASE_URL=postgres://postgres:укажите_ваш_секретный_пароль@postgres_db:5432/postgres?sslmode=disable
